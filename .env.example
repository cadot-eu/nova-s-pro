# ---------------------------------------------------------------------------
# NovaKontrol — copie ce fichier vers .env et renseigne tes valeurs.
#
#   cp .env.example .env
#
# Le fichier .env n'est jamais versionné (voir .gitignore).
# Une variable déjà présente dans l'environnement est toujours prioritaire.
# ---------------------------------------------------------------------------

# Clé API DeepSeek — nécessaire pour « nova create "<demande>" ».
# À créer sur https://platform.deepseek.com/api_keys
# Sans clé, le reste fonctionne : seuls les gabarits (--template) sont disponibles.
DEEPSEEK_API_KEY=

# Modèle utilisé. L'API DeepSeek n'en expose que deux :
#   deepseek-flash    rapide, suffisant pour traduire une intention en paramètres (défaut)
#   deepseek-v4-pro   plus lent et plus cher, pour les demandes retorses
# Les deux raisonnent avant de répondre et acceptent le mode JSON.
# Les anciens noms « deepseek-chat » et « deepseek-reasoner » ne sont plus
# documentés ; « deepseek-chat » reste accepté comme alias de deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Point d'entrée de l'API. À changer seulement si tu passes par un proxy.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Délai maximal d'un appel à DeepSeek, en millisecondes.
DEEPSEEK_TIMEOUT_MS=120000

# Nombre de corrections demandées au modèle s'il produit un exercice invalide.
DEEPSEEK_REPAIR_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Robot
# ---------------------------------------------------------------------------

# Adresse Bluetooth du robot. Laisse vide pour le laisser chercher par scan.
# Récupère-la avec : nova scan
# Une fois connue, la fixer évite un scan de 12 secondes à chaque connexion.
NOVA_ADDRESS=

# Mots-clés (séparés par des virgules) pour reconnaître le robot pendant le scan.
# Le robot est aussi reconnu par le service Bluetooth 0xfeff qu'il annonce.
NOVA_NAME_KEYWORDS=nova,pongbot

# Durée du scan Bluetooth, en millisecondes.
NOVA_SCAN_TIMEOUT_MS=12000

# Délai maximal de connexion au robot.
NOVA_CONNECT_TIMEOUT_MS=20000

# Intervalle du keepalive, en millisecondes. Le robot coupe la liaison après
# environ 13 minutes d'inactivité ; ce signal entretient la connexion.
NOVA_KEEPALIVE_MS=10000

# ---------------------------------------------------------------------------
# Interface web
# ---------------------------------------------------------------------------

# Port et adresse d'écoute de « nova web ». Par défaut, le serveur n'écoute que
# sur la boucle locale : la page n'est pas joignable depuis le réseau.
# Ne mets 0.0.0.0 que si tu sais ce que tu fais.
NOVA_WEB_PORT=4173
NOVA_WEB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Données
# ---------------------------------------------------------------------------

# Où sont enregistrés les exercices. Par défaut : ./data/drills.json
NOVA_DATA_DIR=

# Emplacement du fichier .env lui-même. Utile pour garder plusieurs profils de
# configuration. Laisser vide pour utiliser le .env du projet.
# Une variable d'environnement déjà définie et NON VIDE est toujours prioritaire ;
# une variable vide est traitée comme absente et laissée au fichier.
NOVA_ENV_PATH=
